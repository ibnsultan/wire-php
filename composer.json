{
    "name": "wireblob/wire",
    "description": "Library for interacting with the Wireblob Socket API, providing real-time messaging and event handling capabilities.",
    "type": "library",
    "keywords": ["wire-php-sdk", "wire", "wireblob", "socket", "realtime", "real-time", "real time", "messaging", "push", "trigger", "publish", "events"],
    "license": "MIT",
    "authors": [
        {
            "name": "Abdulbasit Rubeya",
            "homepage": "https://wireblob.com"
        }
    ],
    "require": {
        "php": "^7.3|^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.2",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.3",
        "overtrue/phplint": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Wireblob\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wireblob\\Tests\\": "tests/"
        }
    }
}



